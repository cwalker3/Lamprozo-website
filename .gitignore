# ┌──────────────────────
# │ 1. Ignore everything
# └──────────────────────
*

# ┌──────────────────────
# │ 2. Whitelist root files
# └──────────────────────
!/.gitignore
!/.htaccess
!/LICENSE.md

# ┌──────────────────────
# │ 3. Plugins directory
# └──────────────────────
!plugins/
plugins/*
!plugins/firefly-collective/
plugins/firefly-collective/**

# ┌──────────────────────
# │ 4. Themes directory
# └──────────────────────
!themes/
themes/*
!themes/firefly-collective/
themes/firefly-collective/**

# ┌──────────────────────
# │ 5. Uploads directory
# └──────────────────────
!uploads/
# ignore everything under uploads
uploads/**
# except the campaigns folder itself
!uploads/campaigns/
# then ignore all files inside campaigns
uploads/campaigns/**
# except the .gitkeep placeholder
!uploads/campaigns/.gitkeep

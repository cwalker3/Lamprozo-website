# Ignore everything
*

# Whitelist root files
!/.gitignore
!/.htaccess
!/LICENSE.md

# Plugins directory
!plugins/
plugins/*
!plugins/firefly-collective/
!plugins/firefly-collective/**
!plugins/firefly-projects/
!plugins/firefly-projects/**

# Ignore everything in plugin templates except "default"
plugins/firefly-collective/templates/*
!plugins/firefly-collective/templates/firefly/
!plugins/firefly-collective/templates/firefly/**
!plugins/firefly-collective/templates/default/
!plugins/firefly-collective/templates/default/**
!plugins/firefly-collective/templates/glow/
!plugins/firefly-collective/templates/glow/**

# Themes directory
!themes/
themes/*
!themes/firefly-collective/
!themes/firefly-collective/**

# Ignore everything in theme templates except "default"
themes/firefly-collective/templates/*
!themes/firefly-collective/templates/default/
!themes/firefly-collective/templates/default/**
!themes/firefly-collective/templates/firefly/
!themes/firefly-collective/templates/firefly/**
!themes/firefly-collective/templates/glow/
!themes/firefly-collective/templates/glow/**

# Template schemas - only track core templates (firefly, default, glow)
themes/firefly-collective/data/schemas/*
!themes/firefly-collective/data/schemas/firefly-schema.json
!themes/firefly-collective/data/schemas/default-schema.json
!themes/firefly-collective/data/schemas/glow-schema.json

# Template configurations - user-created templates
plugins/firefly-collective/templates.json
!plugins/firefly-collective/templates.example.json

# Uploads directory
!uploads/
uploads/**
!uploads/campaigns/
uploads/campaigns/**
!uploads/campaigns/.gitkeep

# Cache directory
!cache/
cache/**
!cache/firefly-collective/
cache/firefly-collective/**
!cache/firefly-collective/.gitkeep
# 1. Ignore everything
*

# 2. Whitelist root files
!/.gitignore
!/.htaccess
!/LICENSE.md

# 3. Plugins directory
!plugins/
plugins/*
!plugins/firefly-collective/
!plugins/firefly-collective/**

# 4. Themes directory
!themes/
themes/*
!themes/firefly-collective/
